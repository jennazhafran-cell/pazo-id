<%- include('partials/header', { title: article.title, description: article.content.substring(0, 150) }) %>

<article>
  <div class="article-header">
    <h1><%= article.title %></h1>
    <small style="color:#777;"><%= new Date(article.created_at).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %></small>
  </div>

  <img src="<%= article.thumbnail %>" alt="<%= article.title %>" class="article-img">

  <div class="article-content">
    <p><%- article.content.replace(/\n/g, '<br>') %></p>
  </div>

  <% if(article.entry || article.take_profit || article.stop_loss) { %>
    <div class="trading-params">
      <h3>Parameter Trading</h3>
      <p>Entry: <span style="font-weight:normal;"><%= article.entry || '-' %></span></p>
      <p>Take Profit: <span style="font-weight:normal; color:green;"><%= article.take_profit || '-' %></span></p>
      <p>Stop Loss: <span style="font-weight:normal; color:red;"><%= article.stop_loss || '-' %></span></p>
    </div>
  <% } %>
</article>

<hr style="margin: 40px 0 20px 0; border:0; border-top:1px solid #eee;">

<h3>Analisis Berikutnya</h3>
<div class="grid">
  <% nextArticles.forEach(next => { %>
    <div class="card">
      <img src="<%= next.thumbnail %>" alt="<%= next.title %>">
      <div class="card-body">
        <h4 class="card-title"><%= next.title %></h4>
        <a href="/analisis/<%= next.slug %>" class="btn" style="margin-top:10px;">Baca Analisis</a>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
